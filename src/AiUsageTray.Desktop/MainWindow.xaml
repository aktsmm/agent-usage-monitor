<Window x:Class="AiUsageTray.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 利用状況" Width="420" Height="760" MinWidth="380" MinHeight="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="AI 利用状況" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="使用量・残量と、日・週の目安" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="更新" Click="RefreshClicked" />
        <Button Content="設定" Click="SettingsClicked" />
      </StackPanel>
    </Grid>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="Footer" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
      <TextBlock x:Name="Error" Foreground="{DynamicResource WarningBrush}" FontSize="12" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Cards" />
    </ScrollViewer>
  </DockPanel>
</Window>
