<Window x:Class="AiUsageTray.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource MainTitle}" Width="420" Height="760" MinWidth="380" MinHeight="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="{DynamicResource AgentUsage}" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{DynamicResource MainSubtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
      <WrapPanel Margin="0,8,0,0">
        <Button Content="{DynamicResource Refresh}" Click="RefreshClicked" AutomationProperties.Name="{DynamicResource Refresh}" />
        <Button Content="{DynamicResource History}" Click="HistoryClicked" AutomationProperties.Name="{DynamicResource History}" />
        <Button Content="{DynamicResource Settings}" Click="SettingsClicked" AutomationProperties.Name="{DynamicResource Settings}" />
      </WrapPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="Footer" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
      <TextBlock x:Name="Error" Foreground="{DynamicResource WarningBrush}" FontSize="12" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Cards" />
    </ScrollViewer>
  </DockPanel>
</Window>
